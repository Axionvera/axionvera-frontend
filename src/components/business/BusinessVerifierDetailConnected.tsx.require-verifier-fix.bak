const operationsTeamVerifier =
  requireVerifier("operations-team");

if (!operationsTeamVerifier) {
  throw new Error(
    "Operations Team verifier data is missing."
  );
}

const assignedCampaigns =
  getVerifierAssignedCampaigns(
    "operations-team"
  );

const [
  primaryAssignedCampaign,
  secondaryAssignedCampaign,
] = (() => {
  const [primary, secondary] =
    assignedCampaigns;

  if (!primary || !secondary) {
    throw new Error(
      "Operations Team requires two assigned campaigns."
    );
  }

  return [primary, secondary] as const;
})();

const verifierAssignedCampaignIds =
  new Set(
    operationsTeamVerifier.assignedCampaignIds
  );

const activity =
  businessActivities
    .filter((item) =>
      verifierAssignedCampaignIds.has(
        item.campaignId
      )
    )
    .slice(0, 3)
    .map((item) => {
      const agent =
        requireAgent(item.agentId);

      const campaign =
        requireCampaign(item.campaignId);

      return {
        initials: agent.initials,
        name: agent.name,
        action: item.activity,
        campaign: campaign.name,
        status:
          item.status === "verified"
            ? "Verified"
            : "Pending verification",
        time: item.submittedLabel,
      };
    });


"use client";

import Link from "next/link";
import { useMemo, useState } from "react";
import {
  CURRENCY,
  businessActivities,
  businessActivitySummary,
  requireAgent,
  requireCampaign,
} from "@/lib/axionveraData";
import type {
  ActivityStatus,
} from "@/types/axionvera";

function activitySlug(
  activity: string
) {
  return activity
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, "-")
    .replace(/^-|-$/g, "");
}

const rows = businessActivities.map(
  (item) => {
    const agent =
      requireAgent(item.agentId);

    const campaign =
      requireCampaign(item.campaignId);

    return {
      id: item.id,
      initials: agent.initials,
      agent: agent.name,
      activity: item.activity,
      campaign: campaign.name,
      status: item.status,
      reward:
        item.rewardAmount === null
          ? null
          : `+${item.rewardAmount} ${CURRENCY}`,
      time: item.submittedLabel,
      href:
        item.status === "verified"
          ? `/app/business/activity/${agent.id}/${activitySlug(
              item.activity
            )}`
          : undefined,
    };
  }
);

const businessCampaignOptions =
  Array.from(
    new Set(
      rows.map(
        (row) => row.campaign
      )
    )
  );

function SearchIcon() {
  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      className="h-[18px] w-[18px]"
      strokeWidth="1.8"
    >
      <circle cx="11" cy="11" r="7" />
      <path
        strokeLinecap="round"
        d="m16.5 16.5 4 4"
      />
    </svg>
  );
}

function ChevronLeft() {
  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      className="h-4 w-4"
      strokeWidth="1.9"
    >
      <path
        strokeLinecap="round"
        strokeLinejoin="round"
        d="m15 18-6-6 6-6"
      />
    </svg>
  );
}

function ChevronRight() {
  return (
    <svg
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      className="h-4 w-4"
      strokeWidth="1.9"
    >
      <path
        strokeLinecap="round"
        strokeLinejoin="round"
        d="m9 18 6-6-6-6"
      />
    </svg>
  );
}

export function BusinessActivityConnected() {
  const [status, setStatus] = useState<
    "all" | ActivityStatus
  >("all");

  const [campaign, setCampaign] =
    useState("all");

  const [search, setSearch] = useState("");

  const filteredRows = useMemo(() => {
    const query = search.trim().toLowerCase();

    return rows.filter((row) => {
      const matchesStatus =
        status === "all" ||
        row.status === status;

      const matchesCampaign =
        campaign === "all" ||
        row.campaign === campaign;

      const searchable = [
        row.agent,
        row.activity,
        row.campaign,
        row.status,
        row.reward ?? "",
        row.time,
      ]
        .join(" ")
        .toLowerCase();

      const matchesSearch =
        !query ||
        searchable.includes(query);

      return (
        matchesStatus &&
        matchesCampaign &&
        matchesSearch
      );
    });
  }, [status, campaign, search]);

  return (
    <div className="mx-auto flex w-full max-w-[1400px] flex-col gap-8 pb-16">

      {/* PAGE HEADER */}
      <header>
        <h2 className="font-display text-2xl font-semibold tracking-tight text-white md:text-3xl">
          Activity
        </h2>

        <p className="mt-1.5 text-sm leading-6 text-[#A7B3AB]">
          Track qualifying activity, verification
          status, and reward allocation across your
          campaigns.
        </p>
      </header>

      {/* SUMMARY */}
      <section className="grid grid-cols-1 gap-4 sm:grid-cols-2 lg:grid-cols-3">

        <div className="flex min-h-[116px] flex-col justify-between rounded-xl border border-[#1B2A22] bg-[#0C120F] p-5 transition-colors hover:border-[#294034]">
          <div className="mb-3 flex items-center justify-between">
            <span className="text-[11px] font-semibold uppercase tracking-wider text-[#9DA8A1]">
              Pending verification
            </span>

            <span className="h-2 w-2 rounded-full bg-[#F5B942]" />
          </div>

          <span className="font-display text-3xl font-bold text-white">{businessActivitySummary.pending}</span>
        </div>

        <div className="flex min-h-[116px] flex-col justify-between rounded-xl border border-[#1B2A22] bg-[#0C120F] p-5 transition-colors hover:border-[#294034]">
          <div className="mb-3 flex items-center justify-between">
            <span className="text-[11px] font-semibold uppercase tracking-wider text-[#9DA8A1]">
              Verified activity
            </span>

            <span className="h-2 w-2 rounded-full bg-[#02C763]" />
          </div>

          <span className="font-display text-3xl font-bold text-white">{businessActivitySummary.verified}</span>
        </div>

        <div className="flex min-h-[116px] flex-col justify-between rounded-xl border border-[#1B2A22] bg-[#0C120F] p-5 transition-colors hover:border-[#294034] sm:col-span-2 lg:col-span-1">
          <div className="mb-3 flex items-center justify-between">
            <span className="text-[11px] font-semibold uppercase tracking-wider text-[#9DA8A1]">
              Rewards allocated
            </span>

            <span className="h-2 w-2 rounded-full bg-[#02C763]" />
          </div>

          <div className="flex items-baseline gap-1.5">
            <span className="font-display text-3xl font-bold text-white">
              325
            </span>

            <span className="text-sm font-semibold text-[#9DA8A1]">
              USDC
            </span>
          </div>
        </div>
      </section>

      {/* FILTERS */}
      <section className="flex flex-col items-stretch justify-between gap-4 lg:flex-row lg:items-center">

        <div className="flex flex-wrap items-center gap-3">

          <div className="inline-flex rounded-full bg-[#0C120F] p-1">
            {[
              ["all", "All activity"],
              ["pending", "Pending verification"],
              ["verified", "Verified"],
            ].map(([value, label]) => {
              const active = status === value;

              return (
                <button
                  key={value}
                  type="button"
                  onClick={() =>
                    setStatus(
                      value as
                        | "all"
                        | ActivityStatus
                    )
                  }
                  className={[
                    "rounded-full px-4 py-1.5 text-xs font-medium transition-all",
                    active
                      ? "bg-[#1D211E] font-semibold text-white"
                      : "text-[#A7B3AB] hover:text-white",
                  ].join(" ")}
                >
                  {label}
                </button>
              );
            })}
          </div>

          <select
            value={campaign}
            onChange={(event) =>
            <option value="all">
              All campaigns
            </option>

            {businessCampaignOptions.map(
              (campaignName) => (
                <option
                  key={campaignName}
                  value={campaignName}
                >
                  {campaignName}
                </option>
              )
            )}
          </select>
        </div>

        <div className="relative w-full lg:w-72">
          <span className="pointer-events-none absolute inset-y-0 left-3.5 flex items-center text-[#718277]">
            <SearchIcon />
          </span>

          <input
            type="search"
            value={search}
            onChange={(event) =>
              setSearch(event.target.value)
            }
            placeholder="Search activity..."
            className="w-full rounded-full border-0 bg-[#0C120F] py-2.5 pl-10 pr-4 text-sm text-white outline-none placeholder:text-[#718277] focus:bg-[#142019] focus:ring-0"
          />
        </div>
      </section>

      {/* TABLE */}
      <section className="flex w-full flex-col overflow-hidden rounded-xl border border-[#1B2A22] bg-[#0C120F] shadow-sm">

        <div className="w-full overflow-x-auto">
          <table className="w-full min-w-[900px] border-collapse text-left">

            <thead>
              <tr className="border-b border-[#1B2A22] bg-[#101813] text-[10px] font-semibold uppercase tracking-wider text-[#9DA8A1]">
                <th className="px-6 py-3.5">
                  Agent
                </th>

                <th className="px-6 py-3.5">
                  Activity
                </th>

                <th className="px-6 py-3.5">
                  Campaign
                </th>

                <th className="px-6 py-3.5">
                  Status
                </th>

                <th className="px-6 py-3.5">
                  Reward
                </th>

                <th className="px-6 py-3.5">
                  Time
                </th>

                <th className="px-4 py-3.5 text-right">
                  Actions
                </th>
              </tr>
            </thead>

            <tbody className="divide-y divide-[#1B2A22]/50">
              {filteredRows.map((row) => {
                const verified =
                  row.status === "verified";

                return (
                  <tr
                    key={`${row.agent}-${row.time}`}
                    className="group transition-colors hover:bg-[#142019]"
                  >
                    <td className="px-6 py-4">
                      <div className="flex items-center gap-3">
                        <div
                          className={[
                            "flex h-7 w-7 shrink-0 items-center justify-center rounded-full border border-[#294034]/60 bg-[#16281E] text-xs font-semibold",
                            verified
                              ? "text-[#02C763]"
                              : "text-[#F5B942]",
                          ].join(" ")}
                        >
                          {row.initials}
                        </div>

                        <span className="whitespace-nowrap text-sm font-medium text-white">
                          {row.agent}
                        </span>
                      </div>
                    </td>

                    <td className="whitespace-nowrap px-6 py-4 text-sm text-[#9DA8A1]">
                      {row.activity}
                    </td>

                    <td className="whitespace-nowrap px-6 py-4 text-sm font-medium text-white">
                      {row.campaign}
                    </td>

                    <td className="whitespace-nowrap px-6 py-4">
                      <span
                        className={[
                          "inline-flex items-center gap-1.5 rounded-full px-2.5 py-0.5 text-xs font-medium",
                          verified
                            ? "bg-[#02C763]/10 text-[#02C763]"
                            : "bg-[#F5B942]/10 text-[#F5B942]",
                        ].join(" ")}
                      >
                        <span
                          className={[
                            "h-1.5 w-1.5 rounded-full",
                            verified
                              ? "bg-[#02C763]"
                              : "bg-[#F5B942]",
                          ].join(" ")}
                        />

                        {verified
                          ? "Verified"
                          : "Pending verification"}
                      </span>
                    </td>

                    <td className="whitespace-nowrap px-6 py-4">
                      {row.reward ? (
                        <span className="text-sm font-semibold text-[#02C763]">
                          {row.reward}
                        </span>
                      ) : (
                        <span className="text-sm text-[#718277]">
                          —
                        </span>
                      )}
                    </td>

                    <td className="whitespace-nowrap px-6 py-4 text-xs text-[#718277]">
                      {row.time}
                    </td>

                    <td className="whitespace-nowrap px-4 py-4 text-right">
                      {verified && row.href ? (
                        <Link
                          href={row.href}
                          className="inline-flex rounded border border-[#1B2A22] bg-[#101412] px-2.5 py-1 text-xs font-medium text-[#D0D5D1] transition-colors hover:bg-[#191C1A] hover:text-white"
                        >
                          View
                        </Link>
                      ) : row.agent === "Amina T." ? (
                        <Link
                          href="/app/business/activity/amina-t/merchant-onboarded"
                          className="inline-flex rounded border border-[#02C763]/40 bg-[#02C763]/10 px-3 py-1 text-xs font-medium text-[#02C763] transition-colors hover:bg-[#02C763]/20 hover:text-white"
                        >
                          Review
                        </Link>
                      ) : (
                        <button
                          type="button"
                          className="rounded border border-[#02C763]/40 bg-[#02C763]/10 px-3 py-1 text-xs font-medium text-[#02C763] transition-colors hover:bg-[#02C763]/20 hover:text-white"
                        >
                          Review
                        </button>
                      )}
                    </td>
                  </tr>
                );
              })}

              {filteredRows.length === 0 && (
                <tr>
                  <td
                    colSpan={7}
                    className="px-6 py-12 text-center"
                  >
                    <p className="text-sm font-medium text-white">
                      No matching activity
                    </p>

                    <p className="mt-1 text-xs text-[#718277]">
                      Adjust the filters or search query
                      to see more activity.
                    </p>
                  </td>
                </tr>
              )}
            </tbody>
          </table>
        </div>

        {/* PAGINATION */}
        <div className="flex flex-col items-center justify-between gap-4 border-t border-[#1B2A22] bg-[#101813] px-6 py-4 text-xs text-[#9DA8A1] sm:flex-row">

          <span>
            Showing{" "}
            <strong className="font-semibold text-white">
              {filteredRows.length}
            </strong>{" "}
            of{" "}
            {businessActivitySummary.total} activities
          </span>

          <div className="flex items-center gap-1.5">

            <button
              type="button"
              disabled
              className="flex cursor-not-allowed items-center gap-1 rounded-md px-3 py-1.5 text-[#718277] opacity-50"
            >
              <ChevronLeft />
              Previous
            </button>

            <button
              type="button"
              className="flex h-8 w-8 items-center justify-center rounded-md border border-[#294034] bg-[#16281E] font-semibold text-white"
            >
              1
            </button>

            <button
              type="button"
              className="flex h-8 w-8 items-center justify-center rounded-md text-[#9DA8A1] transition-colors hover:bg-[#142019] hover:text-white"
            >
              2
            </button>

            <span className="px-1 tracking-widest text-[#718277]">
              ...
            </span>

            <button
              type="button"
              className="flex h-8 w-8 items-center justify-center rounded-md text-[#9DA8A1] transition-colors hover:bg-[#142019] hover:text-white"
            >
              16
            </button>

            <button
              type="button"
              className="flex items-center gap-1 rounded-md px-3 py-1.5 text-[#9DA8A1] transition-colors hover:bg-[#142019] hover:text-white"
            >
              Next
              <ChevronRight />
            </button>

          </div>
        </div>
      </section>
    </div>
  );
}

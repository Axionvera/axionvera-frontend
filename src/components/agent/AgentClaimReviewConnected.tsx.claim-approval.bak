          role="dialog"
          aria-modal="true"
          aria-labelledby="claim-wallet-title"
        >
          <div className="w-full max-w-sm rounded-xl border border-[#1B2A22] bg-[#0C120F] p-6 text-center shadow-2xl">

            <div className="mx-auto mb-4 flex h-12 w-12 items-center justify-center rounded-full bg-[#02C763]/10 text-[#02C763]">

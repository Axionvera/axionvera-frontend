export function AgentClaimReviewConnected() {
  const [approvalOpen, setApprovalOpen] =
    useState(false);

  return (
    <div className="mx-auto w-full max-w-2xl pb-16">

      {/* BREADCRUMB */}
      <nav className="mb-4 flex items-center gap-2 text-xs text-[#718277]">
        <Link
          href="/app/agent/rewards"
          className="inline-flex items-center gap-1.5 transition-colors hover:text-white"
        >
          <ArrowLeft />
          Rewards
        </Link>

        <span className="text-[#294034]">
          /
        </span>

        <span className="font-medium text-white">
          Review claim
        </span>
      </nav>

      {/* HEADER */}
      <header className="mb-6">
        <h2 className="font-display text-2xl font-semibold tracking-tight text-white">
          Review claim
        </h2>

        <p className="mt-1 text-sm text-[#A7B3AB]">
          Confirm the rewards you want to claim.
        </p>
      </header>

      {/* REVIEW CARD */}
      <section className="rounded-xl border border-[#1B2A22] bg-[#0C120F] p-6">

        <div className="mb-4">
          <h3 className="font-display text-lg font-semibold text-white">
            Claim details
          </h3>
        </div>

        {/* METRICS */}
        <div className="grid grid-cols-1 gap-3 rounded-lg bg-[#101813] p-4 sm:grid-cols-3">

          <div>
            <span className="text-[10px] font-semibold uppercase tracking-wider text-[#718277]">
              Claim amount
            </span>

            <p className="mt-1 font-display text-lg font-bold text-[#02C763]">
              20 USDC
            </p>
          </div>

          <div>
            <span className="text-[10px] font-semibold uppercase tracking-wider text-[#718277]">
              Current claimable balance
            </span>

            <p className="mt-1 font-display text-lg font-medium text-white">
              20 USDC
            </p>
          </div>

          <div>
            <span className="text-[10px] font-semibold uppercase tracking-wider text-[#718277]">
              Balance after claim
            </span>

            <p className="mt-1 font-display text-lg font-medium text-[#718277]">
              0 USDC
            </p>
          </div>
        </div>

        <div className="my-5 h-px bg-[#1B2A22]" />

        {/* INCLUDED REWARDS */}
        <div>
          <h4 className="mb-3 text-sm font-semibold text-white">
            Rewards included
          </h4>

          <div className="space-y-2.5">

            <div className="flex items-center justify-between gap-4 rounded-lg bg-[#142019] p-3">
              <div className="flex min-w-0 items-center gap-3">
                <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#16281E] text-[#02C763]">
                  <CampaignIcon />
                </div>

                <span className="truncate text-sm font-medium text-white">
                  Merchant Growth Campaign
                </span>
              </div>

              <span className="shrink-0 text-sm font-semibold text-white">
                15 USDC
              </span>
            </div>

            <div className="flex items-center justify-between gap-4 rounded-lg bg-[#142019] p-3">
              <div className="flex min-w-0 items-center gap-3">
                <div className="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-[#16281E] text-[#02C763]">
                  <ReferralIcon />
                </div>

                <span className="truncate text-sm font-medium text-white">
                  Referral Growth Campaign
                </span>
              </div>

              <span className="shrink-0 text-sm font-semibold text-white">
                5 USDC
              </span>
            </div>

            <div className="flex items-center justify-between px-3 pb-1 pt-3">
              <span className="text-sm font-medium text-[#A7B3AB]">
                Total claim
              </span>

              <span className="font-display text-lg font-bold text-white">
                20 USDC
              </span>
            </div>
          </div>
        </div>

        <div className="my-5 h-px bg-[#1B2A22]" />

        {/* INFO */}
        <div className="mb-3 flex items-start gap-3.5 rounded-lg bg-[#101813] p-4">
          <div className="mt-0.5 flex h-6 w-6 shrink-0 items-center justify-center rounded-full bg-[#02C763]/10 text-[#02C763]">
            <InfoIcon />
          </div>

          <p className="text-sm leading-6 text-[#A7B3AB]">
            After the claim completes successfully,
            these rewards will move from{" "}
            <strong className="font-medium text-white">
              Claimable
            </strong>{" "}
            to{" "}
            <strong className="font-medium text-white">
              Claimed
            </strong>
            .
          </p>
        </div>

        <div className="flex items-center gap-2 px-1 text-xs text-[#718277]">
